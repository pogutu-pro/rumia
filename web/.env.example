# API Configuration
# In production Docker, this is overridden by docker-compose with the internal URL.
# Only used as dotenv fallback for server-side code outside the docker network.
NEXT_PUBLIC_API_BASE_URL=https://rumia.co.ke/api/v1
NEXT_PUBLIC_USE_MOCK_API=false

# Authentication
NEXT_PUBLIC_AUTH_REFRESH_PATH=/api/v1/accounts/refresh-token/

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://rumia.co.ke/auth/callback

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site origin (used to build absolute OAuth redirect targets).
# Must match the URL configured in Supabase Auth > URL Configuration.
NEXT_PUBLIC_SITE_URL=https://rumia.co.ke

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Web Push (VAPID) — generate with: npx tsx scripts/generate-vapid-keys.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (optional — leave empty to skip source map uploads)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
