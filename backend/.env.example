# Rumia Backend — Environment Variables
# Copy to .env and fill in real values:  cp .env.example .env

ENVIRONMENT=production
DEBUG=false

# Database (Postgres, async driver)
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=<YOUR_R2_ACCOUNT_ID>
R2_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=rumia-uploads
R2_PUBLIC_URL=https://images.rumia.co.ke

# Web Push (VAPID)
VAPID_PUBLIC_KEY=<YOUR_VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<YOUR_VAPID_PRIVATE_KEY>
VAPID_SUBJECT=mailto:contact@rumia.co.ke

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute

# PostHog Analytics (optional)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Expo Push — mobile notifications (optional)
EXPO_PUSH_ACCESS_TOKEN=

# Brevo Transactional Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@rumia.co.ke
BREVO_SENDER_NAME=Rumia
BREVO_WEBHOOK_SECRET=

# Public site base URL (deep links in emails/push)
PUBLIC_BASE_URL=https://rumia.co.ke

# ── Authentication (Google sign-in, rotating refresh tokens) ────────────────
# openssl rand -hex 32
AUTH_JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorised redirect URI in the Google Cloud console
GOOGLE_REDIRECT_URI=https://rumia.co.ke/auth/google/callback
