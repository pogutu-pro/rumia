# Rumia Backend — Environment Variables
# Copy to .env and fill in real values:  cp .env.example .env

ENVIRONMENT=production
DEBUG=false

# Database (Supabase pooler — async)
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:6543/<DB_NAME>

# Supabase
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_ANON_KEY>
SUPABASE_JWT_SECRET=<YOUR_JWT_SECRET>

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=<YOUR_R2_ACCOUNT_ID>
R2_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=rumia-uploads
R2_PUBLIC_URL=https://images.rumia.co.ke

# Web Push (VAPID)
VAPID_PUBLIC_KEY=<YOUR_VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<YOUR_VAPID_PRIVATE_KEY>
VAPID_SUBJECT=mailto:support@rumia.co.ke

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute

# PostHog Analytics (optional)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Expo Push — mobile notifications (optional)
EXPO_PUSH_ACCESS_TOKEN=
