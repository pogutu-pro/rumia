# Optional. When unset the mobile app resolves the backend automatically:
#  - Android emulator -> http://10.0.2.2:8000/api/v1
#  - iOS simulator / web dev -> http://localhost:8000/api/v1
#  - Physical device -> http://<dev-machine-lan-ip>:8000/api/v1
# Set this only to override (e.g. a physical Android device or deployed API).
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
